+++ b/derp/derpserver/websocket_handoff_test.go
@@ -0,0 +1,61 @@
+package derpserver
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"github.com/coder/websocket"
+	"tailscale.com/derp"
+	"tailscale.com/net/wsconn"
+	"tailscale.com/types/key"
+)
+
+func TestWebSocketHandoff(t *testing.T) {
+	s := New(key.NewNode(), t.Logf)
+	defer s.Close()
+	returned := make(chan struct{})
+	handler := AddWebSocketSupport(s, Handler(s))
+	hs := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		handler.ServeHTTP(w, r)
+		close(returned)
+	}))
+	defer hs.Close()
+	ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
+	defer cancel()
+	conn, _, err := websocket.Dial(ctx, hs.URL+"/derp", &websocket.DialOptions{
+		HTTPClient: hs.Client(), Subprotocols: []string{"derp"},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.CloseNow()
+	select {
+	case <-returned:
+	case <-ctx.Done():
+		t.Fatal("HTTP handler retained for WebSocket lifetime")
+	}
+	wc := wsconn.NetConn(ctx, conn, websocket.MessageBinary, "client")
+	defer wc.Close()
+	privateKey := key.NewNode()
+	client, err := derp.NewClient(privateKey, wc, bufio.NewReadWriter(bufio.NewReader(wc), bufio.NewWriter(wc)), t.Logf)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := client.Recv(); err != nil {
+		t.Fatal(err)
+	}
+	payload := bytes.Repeat([]byte("x"), 4096)
+	if err := client.Send(privateKey.Public(), payload); err != nil {
+		t.Fatal(err)
+	}
+	message, err := client.Recv()
+	packet, ok := message.(derp.ReceivedPacket)
+	if err != nil || !ok || !bytes.Equal(packet.Data, payload) {
+		t.Fatalf("message = %T, error = %v", message, err)
+	}
+}
