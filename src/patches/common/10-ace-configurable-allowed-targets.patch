diff --git a/cmd/derper/ace_policy_test.go b/cmd/derper/ace_policy_test.go
new file mode 100644
--- /dev/null
+++ b/cmd/derper/ace_policy_test.go
@@ -0,0 +1,65 @@
+package main
+
+import (
+	"context"
+	"net"
+	"net/netip"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestACEPublicAddresses(t *testing.T) {
+	for _, address := range []string{"8.8.8.8", "1.1.1.1", "2606:4700:4700::1111", "::ffff:8.8.8.8"} {
+		if !isPublicACEAddress(netip.MustParseAddr(address)) {
+			t.Errorf("public address rejected: %s", address)
+		}
+	}
+	for _, address := range []string{
+		"0.1.2.3", "10.0.0.1", "100.64.0.1", "127.0.0.1", "169.254.169.254",
+		"172.16.0.1", "192.0.0.1", "192.0.2.1", "192.168.0.1", "192.88.99.1",
+		"198.18.0.1", "198.51.100.1", "203.0.113.1", "224.0.0.1", "240.0.0.1",
+		"::", "::1", "::ffff:127.0.0.1", "fc00::1", "fe80::1", "ff02::1",
+		"64:ff9b::a00:1", "2001::1", "2001:db8::1", "2002:7f00:1::", "3fff::1",
+	} {
+		if isPublicACEAddress(netip.MustParseAddr(address)) {
+			t.Errorf("non-public address accepted: %s", address)
+		}
+	}
+}
+
+func TestACEDialRejectsBeforeConnect(t *testing.T) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	ctx, cancel := context.WithTimeout(t.Context(), time.Second)
+	defer cancel()
+	conn, err := aceDialer.DialContext(ctx, "tcp", listener.Addr().String())
+	if conn != nil {
+		conn.Close()
+		t.Fatal("dial connected to loopback")
+	}
+	if err == nil || !strings.Contains(err.Error(), "is not public") {
+		t.Fatalf("dial error = %v", err)
+	}
+	listener.(*net.TCPListener).SetDeadline(time.Now().Add(20 * time.Millisecond))
+	conn, err = listener.Accept()
+	if err == nil {
+		conn.Close()
+		t.Fatal("private destination accepted a connection")
+	}
+}
+
+func TestACETargets(t *testing.T) {
+	targets, err := parseACETargets("CONTROLPLANE.TAILSCALE.COM, headscale.example.com ")
+	if err != nil || !targets.Contains("controlplane.tailscale.com") || !targets.Contains("headscale.example.com") {
+		t.Fatalf("targets = %v, error = %v", targets, err)
+	}
+	for _, value := range []string{"", "example.com,", "example.com:443", "example.com.", "https://example.com", "example com", "*.example.com"} {
+		if _, err := parseACETargets(value); err == nil {
+			t.Errorf("invalid target accepted: %q", value)
+		}
+	}
+}
