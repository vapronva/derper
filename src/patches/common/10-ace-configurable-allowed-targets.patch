+var flagACEAllowedTargets = flag.String("ace-allowed-target", "controlplane.tailscale.com", "comma-separated control-plane hostnames for ACE (exact, case-insensitive match; public addresses only)")
+
+var aceAllowedTargets set.Set[string]
+
+var aceIPv6GlobalUnicast = netip.MustParsePrefix("2000::/3")
+
+var aceBlockedPrefixes = []netip.Prefix{
+	netip.MustParsePrefix("0.0.0.0/8"),
+	netip.MustParsePrefix("100.64.0.0/10"),
+	netip.MustParsePrefix("192.0.0.0/24"),
+	netip.MustParsePrefix("192.0.2.0/24"),
+	netip.MustParsePrefix("192.88.99.0/24"),
+	netip.MustParsePrefix("198.18.0.0/15"),
+	netip.MustParsePrefix("198.51.100.0/24"),
+	netip.MustParsePrefix("203.0.113.0/24"),
+	netip.MustParsePrefix("240.0.0.0/4"),
+	netip.MustParsePrefix("2001::/23"),
+	netip.MustParsePrefix("2001:db8::/32"),
+	netip.MustParsePrefix("2002::/16"),
+	netip.MustParsePrefix("3fff::/20"),
+}
+
+func parseACETargets(value string) (set.Set[string], error) {
+	targets := set.Set[string]{}
+	for host := range strings.SplitSeq(value, ",") {
+		host = strings.ToLower(strings.TrimSpace(host))
+		if err := dnsname.ValidHostname(host); err != nil || strings.HasSuffix(host, ".") {
+			return nil, fmt.Errorf("invalid ACE hostname %q", host)
+		}
+		targets.Add(host)
+	}
+	return targets, nil
+}
+
+func isPublicACEAddress(ip netip.Addr) bool {
+	ip = ip.Unmap()
+	if !ip.IsGlobalUnicast() || ip.IsPrivate() {
+		return false
+	}
+	if ip.Is6() && !aceIPv6GlobalUnicast.Contains(ip) {
+		return false
+	}
+	for _, prefix := range aceBlockedPrefixes {
+		if prefix.Contains(ip) {
+			return false
+		}
+	}
+	return true
+}
+
+var aceDialer = net.Dialer{
+	Control: func(_, address string, _ syscall.RawConn) error {
+		target, err := netip.ParseAddrPort(address)
+		if err != nil {
+			return err
+		}
+		if !isPublicACEAddress(target.Addr()) {
+			return fmt.Errorf("ACE target address %s is not public", target.Addr())
+		}
+		return nil
+	},
+}
