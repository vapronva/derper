diff --git a/derp/derpserver/handler.go b/derp/derpserver/handler.go
index 39fe987c5..a8421bb36 100644
--- a/derp/derpserver/handler.go
+++ b/derp/derpserver/handler.go
@@ -85,16 +85,11 @@ func Handler(s *Server) http.Handler {
 			ctx = IdealNodeContextKey.WithValue(ctx, v)
 		}
 
-		// Replace the hijacked connection's 4KB bufio.Reader with a
-		// smaller one; DERP frame payloads are read with io.ReadFull,
-		// which bypasses the buffer for reads larger than it. Fast-start
-		// clients send their auth frame with the HTTP request, so drain
-		// any buffered bytes first, releasing the old reader when empty.
 		readConn := netConn
 		if brw.Reader.Buffered() != 0 {
 			readConn = netutil.NewDrainBufConn(netConn, brw.Reader)
 		}
-		br := bufio.NewReaderSize(readConn, 1<<10)
+		br := bufio.NewReaderSize(readConn, 4<<10)
 		// The nil Writer makes Accept's internal lazyBufioWriter pull
 		// a pooled buffer on demand rather than retaining one per
 		// connection.
