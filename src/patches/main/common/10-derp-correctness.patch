diff --git a/derp/derpserver/peergone_rewatch_test.go b/derp/derpserver/peergone_rewatch_test.go
new file mode 100644
index 0000000..027b070
--- /dev/null
+++ b/derp/derpserver/peergone_rewatch_test.go
@@ -0,0 +1,57 @@
+package derpserver
+
+import (
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"tailscale.com/derp"
+	"tailscale.com/derp/derphttp"
+	"tailscale.com/net/netmon"
+	"tailscale.com/types/key"
+	"tailscale.com/types/logger"
+)
+
+func TestRepeatedPeerGone(t *testing.T) {
+	s := New(key.NewNode(), t.Logf)
+	defer s.Close()
+	hs := httptest.NewServer(Handler(s))
+	defer hs.Close()
+	connect := func(priv key.NodePrivate) *derphttp.Client {
+		c, err := derphttp.NewClient(priv, hs.URL+"/derp", logger.Discard, netmon.NewStatic())
+		if err != nil {
+			t.Fatal(err)
+		}
+		t.Cleanup(func() { c.Close() })
+		if err := c.Connect(t.Context()); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := c.Recv(); err != nil {
+			t.Fatal(err)
+		}
+		return c
+	}
+	receiver := connect(key.NewNode())
+	timeout := time.AfterFunc(10*time.Second, func() { receiver.Close() })
+	defer timeout.Stop()
+	senderKey := key.NewNode()
+	for attempt := range 3 {
+		sender := connect(senderKey)
+		if err := sender.Send(receiver.SelfPublicKey(), []byte("hello")); err != nil {
+			t.Fatal(err)
+		}
+		if packet, err := receiver.Recv(); err != nil {
+			t.Fatal(err)
+		} else if _, ok := packet.(derp.ReceivedPacket); !ok {
+			t.Fatalf("packet is %T", packet)
+		}
+		sender.Close()
+		msg, err := receiver.Recv()
+		if err != nil {
+			t.Fatalf("disconnect %d: %v", attempt+1, err)
+		}
+		if gone, ok := msg.(derp.PeerGoneMessage); !ok || gone.Peer != senderKey.Public() || gone.Reason != derp.PeerGoneReasonDisconnected {
+			t.Fatalf("disconnect %d: got %#v", attempt+1, msg)
+		}
+	}
+}
