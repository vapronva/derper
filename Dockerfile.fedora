ARG TOOLS_IMAGE=docker.horse/ci/on-alpine/tools:1

FROM $TOOLS_IMAGE AS tools

FROM docker.io/library/golang:1.27-trixie AS builder

ARG MIRROR_GO_URL=""
ARG TAILSCALE_SOURCE=src/tailscale

WORKDIR /build

COPY $TAILSCALE_SOURCE ./

RUN if [ -n "$MIRROR_GO_URL" ]; then go env -w GOPROXY="${MIRROR_GO_URL%/}|https://proxy.golang.org,direct"; fi

RUN VER="$(cat VERSION.txt)" && \
    CGO_ENABLED=0 go build -trimpath \
    -ldflags="-s -w -X tailscale.com/version.longStamp=${VER} -X tailscale.com/version.shortStamp=${VER}" \
    -o /derper ./cmd/derper

FROM docker.io/library/fedora:44

ARG MIRROR_FEDORA_URL=""

ARG MIRROR_FEDORA_FALLBACK_URL=""

ARG MIRROR_FEDORA_CODECS_URL=""

WORKDIR /app

COPY --from=tools /usr/local/bin/pkg-base-setup /usr/local/bin/

RUN pkg-base-setup && \
    mkdir /app/certs

ENV DERP_DOMAIN=your-hostname.com
ENV DERP_CERT_MODE=letsencrypt
ENV DERP_CERT_DIR=/app/certs
ENV DERP_ACME_EMAIL=""
ENV DERP_ADDR=:443
ENV DERP_STUN=true
ENV DERP_STUN_PORT=3478
ENV DERP_HTTP_PORT=80
ENV DERP_HOME=""
ENV DERP_BOOTSTRAP_DNS_NAMES=""
ENV DERP_UNPUBLISHED_BOOTSTRAP_DNS_NAMES=""
ENV DERP_VERIFY_CLIENTS=false
ENV DERP_VERIFY_CLIENT_URL=""
ENV DERP_VERIFY_CLIENT_URL_FAIL_OPEN=true
ENV DERP_MESH_PSK_FILE=""
ENV DERP_MESH_WITH=""
ENV TAILSCALE_DERPER_MESH_KEY=""
ENV DERP_ACE=false
ENV DERP_ACE_ALLOWED_TARGET=controlplane.tailscale.com

COPY --from=builder /derper .

CMD if [ -n "$TAILSCALE_DERPER_MESH_KEY" ]; then \
        umask 077 && \
        printf '%s' "$TAILSCALE_DERPER_MESH_KEY" > /app/meshkey && \
        DERP_MESH_PSK_FILE=/app/meshkey; \
    fi && \
    /app/derper --hostname=$DERP_DOMAIN \
    --certmode=$DERP_CERT_MODE \
    --certdir=$DERP_CERT_DIR \
    --acme-email=$DERP_ACME_EMAIL \
    --a=$DERP_ADDR \
    --stun=$DERP_STUN \
    --stun-port=$DERP_STUN_PORT \
    --http-port=$DERP_HTTP_PORT \
    --home=$DERP_HOME \
    --bootstrap-dns-names=$DERP_BOOTSTRAP_DNS_NAMES \
    --unpublished-bootstrap-dns-names=$DERP_UNPUBLISHED_BOOTSTRAP_DNS_NAMES \
    --verify-clients=$DERP_VERIFY_CLIENTS \
    --verify-client-url=$DERP_VERIFY_CLIENT_URL \
    --verify-client-url-fail-open=$DERP_VERIFY_CLIENT_URL_FAIL_OPEN \
    --mesh-psk-file=$DERP_MESH_PSK_FILE \
    --mesh-with=$DERP_MESH_WITH \
    --ace=$DERP_ACE \
    --ace-allowed-target=$DERP_ACE_ALLOWED_TARGET
